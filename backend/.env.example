# Copy this file to .env and fill in real values for local dev.
# Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=8787
APP_BASE_URL=http://localhost:8787
WEB_BASE_URL=http://localhost:5500

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgres://aymora:aymora_dev_password@localhost:5432/aymora

# --- Redis (rate limiting + job queues) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# openssl rand -hex 32
JWT_ACCESS_SECRET=dev_only_change_me_access
JWT_REFRESH_SECRET=dev_only_change_me_refresh

# --- Email provider ---
# Leave RESEND_API_KEY unset in dev: emails are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Aymora <hello@aymora.in>

# --- AI (Gemini, free tier) ---
# Get a free key at https://aistudio.google.com/apikey
# Leave unset to run the profiling pipeline in stub mode (deterministic fake profiles).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Payments (Razorpay TEST mode only) ---
# Test keys from the Razorpay dashboard (Test Mode toggle) - never put live keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Admin (Phase 6 trust & safety endpoints) ---
# openssl rand -hex 24
ADMIN_API_KEY=
